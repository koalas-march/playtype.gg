/* ============================================================
   Playtype.gg i18n core runtime
   - 言語検出（/ko/ プレフィックス + localStorage）
   - t(key) 辞書ルックアップ（ja フォールバック）
   - data-i18n による静的HTML翻訳
   - 言語スイッチャー / hreflang・canonical 注入
   - 将来の en / zh 追加を見据えた設計（SUPPORTED に足すだけ）
   セキュリティ: 文字列はすべて辞書経由。innerHTML は data-i18n-html を
   明示指定した「制作者管理の固定文字列」のみに限定（ユーザー入力は通さない）。
   ============================================================ */
(function () {
  'use strict';

  // 対応言語（先頭が既定=ja）。en/zh は辞書とデータKOを用意すれば追加可能。
  var SUPPORTED = ['ja', 'ko'];
  var DEFAULT = 'ja';
  var PREFIX_RE = /^\/(ko|en|zh)(?=\/|$)/; // URLの言語プレフィックス

  function detectLang() {
    try {
      var m = location.pathname.match(PREFIX_RE);
      if (m) return m[1];
    } catch (e) {}
    try {
      var st = localStorage.getItem('pt_lang');
      if (st && SUPPORTED.indexOf(st) >= 0) return st;
    } catch (e) {}
    return DEFAULT;
  }

  var LANG = detectLang();
  window.PT_LANG = LANG;
  window.PT_LANGS = SUPPORTED;
  try { localStorage.setItem('pt_lang', LANG); } catch (e) {}
  try { document.documentElement.setAttribute('lang', LANG); } catch (e) {}

  // UI辞書。i18n-ui-ja.js / i18n-ui-ko.js が PT_DICT[lang] を埋める。
  window.PT_DICT = window.PT_DICT || {};

  // t(key): 現在言語→ja→key の順でフォールバック（翻訳漏れでも壊れない）
  window.t = function (key) {
    var d = window.PT_DICT[LANG] || {};
    if (Object.prototype.hasOwnProperty.call(d, key)) return d[key];
    var ja = window.PT_DICT[DEFAULT] || {};
    if (Object.prototype.hasOwnProperty.call(ja, key)) return ja[key];
    return key;
  };

  // 言語別データ選択ヘルパー: pick({ja:..., ko:...}) / pickVar('TYPE_DATA')
  window.PTpick = function (obj) {
    if (!obj) return obj;
    if (obj[LANG] != null) return obj[LANG];
    return obj[DEFAULT];
  };

  // 静的HTMLの適用
  window.applyI18nStatic = function (root) {
    root = root || document;
    var i, els;
    els = root.querySelectorAll('[data-i18n]');
    for (i = 0; i < els.length; i++) {
      var v = window.t(els[i].getAttribute('data-i18n'));
      if (v != null) els[i].textContent = v;
    }
    els = root.querySelectorAll('[data-i18n-html]');
    for (i = 0; i < els.length; i++) {
      var vh = window.t(els[i].getAttribute('data-i18n-html'));
      if (vh != null) els[i].innerHTML = vh; // 固定文字列のみ（辞書管理）
    }
    els = root.querySelectorAll('[data-i18n-attr]');
    for (i = 0; i < els.length; i++) {
      var el = els[i];
      var spec = el.getAttribute('data-i18n-attr');
      spec.split(';').forEach(function (pair) {
        var idx = pair.indexOf(':');
        if (idx < 0) return;
        var attr = pair.slice(0, idx).trim();
        var key = pair.slice(idx + 1).trim();
        var av = window.t(key);
        if (av != null) el.setAttribute(attr, av);
      });
    }
  };

  // 言語プレフィックスを外した現在パス
  function basePath() {
    var p = '/';
    try { p = location.pathname.replace(PREFIX_RE, '') || '/'; } catch (e) {}
    if (p.charAt(0) !== '/') p = '/' + p;
    return p;
  }
  // 指定言語での絶対URL
  function urlFor(lang, path) {
    var pfx = (lang === DEFAULT) ? '' : '/' + lang;
    var pp = path || basePath();
    return location.origin + pfx + (pp === '/' && pfx ? '/' : pp);
  }
  window.PTurlFor = urlFor;

  // canonical + hreflang alternates の注入
  window.applyI18nSEO = function () {
    try {
      var head = document.head;
      // canonical
      var can = head.querySelector('link[rel="canonical"]');
      if (!can) { can = document.createElement('link'); can.rel = 'canonical'; head.appendChild(can); }
      can.href = urlFor(LANG);
      // 既存のalt除去。
      // data-i18n-alt 付き（前回の注入ぶん）だけでなく、HTMLに静的に書かれた
      // hreflang も対象にする。静的3件＋注入3件で hreflang が二重になり、
      // Google が代替アノテーションを無視する原因になっていたため。
      var olds = head.querySelectorAll('link[rel="alternate"][hreflang]');
      for (var i = 0; i < olds.length; i++) olds[i].parentNode.removeChild(olds[i]);
      // 各言語 + x-default
      SUPPORTED.forEach(function (lg) {
        var l = document.createElement('link');
        l.rel = 'alternate'; l.hreflang = lg; l.href = urlFor(lg);
        l.setAttribute('data-i18n-alt', '1'); head.appendChild(l);
      });
      var x = document.createElement('link');
      x.rel = 'alternate'; x.hreflang = 'x-default'; x.href = urlFor(DEFAULT);
      x.setAttribute('data-i18n-alt', '1'); head.appendChild(x);
      // og:locale
      var og = head.querySelector('meta[property="og:locale"]');
      if (!og) { og = document.createElement('meta'); og.setAttribute('property', 'og:locale'); head.appendChild(og); }
      og.setAttribute('content', LANG === 'ko' ? 'ko_KR' : 'ja_JP');
    } catch (e) {}
  };

  // <title> / meta description の言語別化（辞書キー: meta.title / meta.desc）
  window.applyI18nMeta = function () {
    try {
      var tt = window.t('meta.title');
      if (tt && tt !== 'meta.title') document.title = tt;
      var dd = window.t('meta.desc');
      var md = document.querySelector('meta[name="description"]');
      if (md && dd && dd !== 'meta.desc') md.setAttribute('content', dd);
      var ot = document.querySelector('meta[property="og:title"]');
      var otv = window.t('meta.ogtitle');
      if (ot && otv && otv !== 'meta.ogtitle') ot.setAttribute('content', otv);
      var od = document.querySelector('meta[property="og:description"]');
      var odv = window.t('meta.ogdesc');
      if (od && odv && odv !== 'meta.ogdesc') od.setAttribute('content', odv);
      // twitter もタイトル/説明を言語連動（ブラウザ表示用）
      var tt2 = document.querySelector('meta[name="twitter:title"]');
      if (tt2 && otv && otv !== 'meta.ogtitle') tt2.setAttribute('content', otv);
      var td2 = document.querySelector('meta[name="twitter:description"]');
      if (td2 && odv && odv !== 'meta.ogdesc') td2.setAttribute('content', odv);
    } catch (e) {}
  };

  // 言語切替: 現在パスを保ちつつプレフィックスだけ差し替えて遷移
  window.setLang = function (lang) {
    if (SUPPORTED.indexOf(lang) < 0) return;
    try { localStorage.setItem('pt_lang', lang); } catch (e) {}
    var pfx = (lang === DEFAULT) ? '' : '/' + lang;
    var to = pfx + basePath() + location.search + location.hash;
    if (!to) to = '/';
    location.href = to;
  };

  // 起動時適用（DOMContentLoaded後）
  function boot() {
    window.applyI18nStatic(document);
    window.applyI18nMeta();
    window.applyI18nSEO();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
