/* ============================================================
   Playtype.gg インプレッション広告（手動レスポンシブ・ディスプレイ）
   ------------------------------------------------------------
   ・Auto Ads / アンカー広告 / 全画面広告 / 動画広告 / AMP は使わない。
   ・Amazon アフィリエイト用の assets/ads.js とは完全に別物。混ぜない。
   ・AdSense ライブラリは「本番ホスト」でだけ読み込む。1ページ1回だけ。
   ・検証環境（*.workers.dev / localhost / file:）は Google へ一切通信せず、
     同じ寸法のプレースホルダーだけを出す。開発者の誤クリックを防ぐ。
   ・1枠につき push は1回。SPA の画面切り替えや REPLAY で増殖させない。
   ・取得失敗（unfilled）は枠ごと畳んで、空の巨大領域を残さない。
   ============================================================ */
(function(){
  'use strict';

  var CFG={
    client:'ca-pub-7463421104308118',
    /* 枠ごとの固有 slot ID。ここ1か所だけで管理する */
    slots:{
      home              :'5585026794',  /* HOME：GAME SELECT と演出が終わった後 */
      quiz              :'2775407924',  /* 診断中：質問・回答のまとまりの下 */
      /* 結果は経路ごとに固定コンテナを持つ。slot ID は共通で構わない。
         章間の横長1件に加え、十分に広い PC でだけ左右余白の2件を出す。 */
      'result-playtype' :'7995945010',
      'result-256'      :'7995945010',
      'result-soulmate' :'7995945010',  /* 広告①：TYPE MATCH 終了後 → WHY 開始前 */
      'result-mid'      :'9500170747',  /* 広告②：CATCH 終了後 → APPENDIX 開始前（soulmate のみ） */
      'result-playtype-gutter-left' :'7995945010',
      'result-playtype-gutter-right':'7995945010',
      'result-256-gutter-left'      :'7995945010',
      'result-256-gutter-right'     :'7995945010',
      'result-soulmate-gutter-left' :'7995945010',
      'result-soulmate-gutter-right':'7995945010'
    },
    /* 左右余白広告の表示条件 */
    /* adWidth / adGap は impression-ads.css の --pt-gut / --pt-gap と同値にする。
       minGutter は「広告1列＋間隔＋ページ端の余白8px」以上でなければならない。 */
    gutter:{minViewport:1600,minGutter:192,minBodyHeight:1400,minAdWidth:120,adWidth:160,adGap:24},
    /* 実広告を読み込む本番ホスト。ここ以外は必ずプレビュー扱い */
    prodHosts:['playtype.gg','www.playtype.gg'],
    lib:'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js'
  };

  var LABEL='広告';
  var PREVIEW_TEXT='ADVERTISEMENT PREVIEW';

  function isProd(){
    try{
      if(location.protocol!=='http:'&&location.protocol!=='https:')return false;
      for(var i=0;i<CFG.prodHosts.length;i++)
        if(location.hostname===CFG.prodHosts[i])return true;
      return false;
    }catch(e){ return false; }
  }

  /* ---- ライブラリの読み込み。1ページ1回だけ ---- */
  var libState=0;   /* 0=未 1=要求済み */
  /* CMP をページ訪問時から動かせるよう、ライブラリの読み込みは初期化時に済ませる。
     広告枠の push は IntersectionObserver 後に別処理で行う（Auto Ads は使わない）。 */
  function ensureLib(){
    if(!isProd())return false;
    if(libState)return true;
    if(document.querySelector('script[src*="adsbygoogle.js"]')){ libState=1; return true; }
    try{
      var s=document.createElement('script');
      s.async=true;
      s.src=CFG.lib+'?client='+encodeURIComponent(CFG.client);
      s.crossOrigin='anonymous';
      /* 取得できなくてもページ機能は止めない */
      s.onerror=function(){};
      (document.head||document.documentElement).appendChild(s);
      libState=1;
      return true;
    }catch(e){ return false; }
  }

  /* ---- unfilled の監視。埋まらなければ枠を畳む ---- */
  function watchFill(box,ins){
    var tries=0;
    function check(){
      tries++;
      var st=ins.getAttribute('data-ad-status');
      if(st==='unfilled'){ box.setAttribute('data-pt-state','unfilled'); return; }
      if(st==='filled'){ box.setAttribute('data-pt-state','filled'); return; }
      if(tries<20)setTimeout(check,500);      /* 最長10秒。自動更新はしない */
      else box.setAttribute('data-pt-state','filled');  /* 判定不能なら予約を解く */
    }
    setTimeout(check,700);
  }

  /* ---- 1枠を組み立てる。すでに組み立て済みなら何もしない ---- */
  function mount(box){
    if(!box||box.getAttribute('data-pt-ad-mounted')==='1')return false;
    var kind=box.getAttribute('data-pt-ad');
    var slot=CFG.slots[kind];
    if(!slot)return false;
    /* 非表示・幅0では push しない。幅が確定してから作る。 */
    var r=null; try{ r=box.getBoundingClientRect(); }catch(e){}
    if(!r||r.width<1)return false;
    box.setAttribute('data-pt-ad-mounted','1');
    box.setAttribute('data-pt-state','reserved');

    var label=document.createElement('span');
    label.className='pt-impression-ad-label';
    label.textContent=LABEL;                 /* 「広告」以外の見出しは付けない */
    box.appendChild(label);

    if(!isProd()){
      /* 検証環境：Google へ通信しない。同じ寸法のプレースホルダーを出す */
      var ph=document.createElement('div');
      ph.className='pt-impression-ad-preview';
      ph.textContent=PREVIEW_TEXT;
      box.appendChild(ph);
      box.setAttribute('data-pt-state','preview');
      return true;
    }

    var ins=document.createElement('ins');
    ins.className='adsbygoogle pt-impression-ad-slot';
    ins.setAttribute('data-ad-client',CFG.client);
    ins.setAttribute('data-ad-slot',slot);
    ins.setAttribute('data-ad-format','auto');
    ins.setAttribute('data-full-width-responsive','true');
    box.appendChild(ins);

    if(!ensureLib()){ box.setAttribute('data-pt-state','unfilled'); return true; }
    try{
      (window.adsbygoogle=window.adsbygoogle||[]).push({});   /* 1枠1回だけ */
      watchFill(box,ins);
    }catch(e){
      box.setAttribute('data-pt-state','unfilled');            /* 失敗してもページは止めない */
    }
    return true;
  }

  /* ---- 画面内に入ってから組み立てる（無駄な取得をしない） ---- */
  function arm(box){
    if(!box||box.getAttribute('data-pt-ad-mounted')==='1')return;
    /* 左右余白広告は条件ゲート（updateGutters）だけが mount できる。
       通常の scan からは触らない。 */
    if(box.closest&&box.closest('.pt-gutter'))return;
    if(box.getAttribute('data-pt-ad-armed')==='1'){ mount(box); return; }
    box.setAttribute('data-pt-ad-armed','1');
    var io=null;
    try{
      io=new IntersectionObserver(function(en){
        if(!en||!en[0]||!en[0].isIntersecting)return;
        /* 幅が確定していなければ切らずに待つ（結果セクションが開くまで） */
        if(mount(box))io.disconnect();
      },{rootMargin:'200px 0px'});
      io.observe(box);
    }catch(e){ mount(box); }
  }

  /* ---- 左右余白広告のゲート ----
     すべて満たしたときだけ表示・初期化する。1つでも欠ければ push しない。
       ・viewport 幅 1600px 以上
       ・中央本文の左右に各 180px 以上の実余白
       ・結果本文の高さ 1400px 以上
       ・結果セレモニーが完全終了済み
       ・開始ゲート / CMP / モーダルが表示中でない
       ・広告枠の実幅 120px 以上
       ・ポインタが粗くない（モバイル・タブレットを除外）
     条件未達なら DOM は残したまま完全非表示にする。 */
  function isDesktop(){
    try{ return window.matchMedia('(hover:hover) and (pointer:fine)').matches; }
    catch(e){ return true; }
  }
  function blockingUi(){
    if(document.getElementById('sfxGate'))return true;              /* 開始ゲート */
    if(document.body&&document.body.classList.contains('ov'))return true; /* モーダル */
    /* CMP のダイアログ（Google Funding Choices の一般的な入れ物） */
    if(document.querySelector('.fc-consent-root,.fc-dialog-overlay'))return true;
    return false;
  }
  function ceremonyDone(){
    try{
      if(window.SoulFX&&window.SoulFX.landing){
        /* 演出中はゴーストが残っている。0 件なら着地完了とみなす */
        return document.querySelectorAll('.sfx-ghost').length===0;
      }
    }catch(e){}
    return true;
  }
  function gutterOk(wrap){
    var g=CFG.gutter;
    if(!wrap)return false;
    /* その結果画面が実際に表示されているときだけ。閉じている経路には出さない */
    var sec=wrap.closest&&wrap.closest('[data-pt-ad-result]');
    if(sec&&!shown(sec))return false;
    var scr=wrap.querySelector('.screen');
    if(scr&&scr.classList.contains('hidden'))return false;
    if(!isDesktop())return false;
    if((window.innerWidth||0)<g.minViewport)return false;
    if(blockingUi())return false;
    if(!ceremonyDone())return false;
    var center=wrap.querySelector('.pt-center');
    var left=wrap.querySelector('.pt-gutter-l');
    var right=wrap.querySelector('.pt-gutter-r');
    if(!center||!left||!right)return false;
    var wr,br;
    try{ wr=wrap.getBoundingClientRect(); br=bodyRect(center); }catch(e){ return false; }
    if(!br)return false;
    if(br.height<g.minBodyHeight)return false;                       /* 長文結果だけ */
    /* 余白は「本文の外側にどれだけ空いているか」で測る。
       ラッパー基準（本文が親の全幅を使う面）と viewport 基準（本文が
       max-width で絞られている面）の広いほうを採る。ラッパーの幅で
       本文を縮めないため、ここではラッパーの幅を条件にしない。 */
    var docW=(document.documentElement&&document.documentElement.clientWidth)||window.innerWidth||0;
    var freeL=Math.max(br.left-wr.left, br.left);
    var freeR=Math.max(wr.right-br.right, docW-br.right);
    if(freeL<g.minGutter||freeR<g.minGutter)return false;
    if(g.minGutter<(g.adWidth+g.adGap+8))return false;               /* 設定の自己矛盾防止 */
    return true;
  }
  /* 中央本文の実矩形。.pt-center は面によって全幅になるので、
     幅を決めている中身（HOME=.result-in / soulmate=#s-result）を測る。 */
  function bodyRect(center){
    var el=center.firstElementChild||center;
    var r=el.getBoundingClientRect();
    if(r.width<1)return null;
    return r;
  }
  function updateGutters(){
    var ws=document.querySelectorAll('.pt-gutters');
    for(var i=0;i<ws.length;i++){
      var w=ws[i], ok=gutterOk(w);
      /* 一度 push した広告は消したり動かしたりしない。未 push のものだけ制御する */
      w.setAttribute('data-pt-gutter', ok?'on':'off');
      var b=w.querySelectorAll('.pt-gutter [data-pt-ad]');
      for(var k=0;k<b.length;k++){
        if(b[k].getAttribute('data-pt-ad-mounted')==='1')continue;
        b[k].setAttribute('data-pt-state', ok?'':'skip');
        if(ok)mount(b[k]);
      }
    }
  }

  /* ---- SPA の結果画面 ----
     通常 Playtype 結果（#result）と 256 統合診断結果（#result256）は
     それぞれ固定の広告コンテナを1件ずつ持つ。
     読み込み済みの ins / iframe は絶対に reparent しない。
     PC と モバイルの置き場所の違いは CSS Grid だけで切り替える。
     ここでは「表示されたら push を試す」だけを行う。 */
  function shown(sec){
    if(sec.getAttribute('aria-hidden')==='false')return true;
    return sec.classList&&sec.classList.contains('on');
  }
  function watchResults(){
    var secs=document.querySelectorAll('[data-pt-ad-result]');
    for(var i=0;i<secs.length;i++)(function(sec){
      if(shown(sec)){ API.scan(sec); updateGutters(); }
      try{
        var mo=new MutationObserver(function(){
          if(shown(sec)){ API.scan(sec); setTimeout(updateGutters,120); }
        });
        mo.observe(sec,{attributes:true,attributeFilter:['aria-hidden','class']});
      }catch(e){}
    })(secs[i]);
    /* リサイズでは DOM を動かさない。未 push の左右枠の可否だけを見直す */
    var rz=null;
    try{
      window.addEventListener('resize',function(){
        clearTimeout(rz); rz=setTimeout(updateGutters,250);
      },{passive:true});
    }catch(e){}
  }

  /* ---- 公開 API ---- */
  var API={
    /* data-pt-ad を持つ枠をまとめて準備する。何度呼んでも増殖しない */
    scan:function(root){
      var n=(root||document).querySelectorAll('[data-pt-ad]');
      for(var i=0;i<n.length;i++)arm(n[i]);
      return n.length;
    },
    mountOne:function(box){ return mount(box); },
    /* 左右余白広告の可否を見直す（演出完了後など） */
    updateGutters:updateGutters,
    isProd:isProd,
    /* 検証用。判定には使わない */
    state:function(){
      var n=document.querySelectorAll('[data-pt-ad]'), a=[];
      for(var i=0;i<n.length;i++)a.push({
        kind:n[i].getAttribute('data-pt-ad'),
        mounted:n[i].getAttribute('data-pt-ad-mounted')==='1',
        state:n[i].getAttribute('data-pt-state')
      });
      var g=[];
      var ws=document.querySelectorAll('.pt-gutters');
      for(var k=0;k<ws.length;k++){
        var c=ws[k].querySelector('.pt-center');
        var wr=ws[k].getBoundingClientRect(), br=c?bodyRect(c):null;
        var dw=(document.documentElement&&document.documentElement.clientWidth)||window.innerWidth||0;
        g.push({on:ws[k].getAttribute('data-pt-gutter'),
                viewport:window.innerWidth,
                center:br?Math.round(br.width):null,
                left:br?Math.round(Math.max(br.left-wr.left,br.left)):null,
                right:br?Math.round(Math.max(wr.right-br.right,dw-br.right)):null,
                bodyHeight:br?Math.round(br.height):null});
      }
      return {prod:isProd(),lib:libState===1,
              units:document.querySelectorAll('ins.adsbygoogle').length,
              pushed:(window.adsbygoogle&&window.adsbygoogle.length)||0,
              boxes:a,gutters:g};
    }
  };
  window.PTAds=API;

  function boot(){
    ensureLib();          /* 本番ホストだけ。ページ初期化時に1回 */
    API.scan(document);   /* 枠の準備。push は交差後 */
    watchResults();
    updateGutters();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);
  else boot();
})();
