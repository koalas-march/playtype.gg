/* ============================================================
   Playtype.gg ショップ設定 — 唯一の情報源 (Single Source of Truth)
   ブラウザ(<script src="/shop-config.js">)と
   Edge Function(import '../_shared/shop-config.js')の両方がこの1ファイルを読む。
   ------------------------------------------------------------
   価格変更はこのファイルだけを編集:
     - saleEnabled: セール(リリース記念価格)の有効/無効
     - saleEnd: 'YYYY-MM-DD' か日時付き ISO(例 '2026-08-07T18:00:00+09:00')。この時刻を過ぎると自動で通常価格に切替
     - 編集後: ①_deploy/shop-config.js へ上書きコピーしてサイトをアップ
              ②supabase functions deploy create-checkout-session
   ============================================================ */
(function (g) {
  'use strict';

  var SHOP_CONFIG = {
    saleEnabled: true,
    currentPrice: 700,
    normalPrice: 980,
    // セール期間: saleStart <= 現在時刻 < saleEnd（日本時間）
    // 'YYYY-MM-DD' は その日の00:00 JST。日時付きISOなら その時刻(JST)が境界。saleEnd以降は通常価格。
    // 例: start '2026-07-20', end '2026-08-04' → 8/3の23:59まで700円、8/4から980円
    saleStart: '2026-07-20',
    saleEnd: '2026-08-07T18:00:00+09:00',
    notice: 'セール終了後は通常価格に戻ります',
  };

  // 16タイプ × { product, priceSale(700円), priceNormal(980円) }
  var PRODUCTS = {
    AIPL: { product: 'prod_UtsToIoFL7yHwX', priceSale: 'price_1TuDEoJuMueKdUi2y45XAZmm', priceNormal: 'price_1TuYVdJuMueKdUi2tsik7Okf' },
    AIPB: { product: 'prod_UtsqzulI2zUlcA', priceSale: 'price_1TuDEmJuMueKdUi2rXnmDj5t', priceNormal: 'price_1TuYVRJuMueKdUi2FnISk69B' },
    AIRL: { product: 'prod_UtstT379Mz27q3', priceSale: 'price_1TuDEmJuMueKdUi2WLqAAtWZ', priceNormal: 'price_1TuYVGJuMueKdUi2LievAYqf' },
    ATPL: { product: 'prod_UtsuovXHpLBTjr', priceSale: 'price_1TuDEkJuMueKdUi234XqGsGw', priceNormal: 'price_1TuYV4JuMueKdUi2GeeczTG6' },
    ATRL: { product: 'prod_UtsvXfFmdDFUJb', priceSale: 'price_1TuDEkJuMueKdUi28E1Dlvnk', priceNormal: 'price_1TuYUqJuMueKdUi29VR26l6A' },
    ATRB: { product: 'prod_Utswxzq2K5kfdy', priceSale: 'price_1TuDEiJuMueKdUi2YGLbBpwY', priceNormal: 'price_1TuYUWJuMueKdUi270mgeXzL' },
    SIPL: { product: 'prod_UttYbykzekSpMq', priceSale: 'price_1TuDEdJuMueKdUi2FoIUCTrt', priceNormal: 'price_1TuYUBJuMueKdUi2cQ7YVDv6' },
    AIRB: { product: 'prod_UtsyJ4g4W9BTaT', priceSale: 'price_1TuDEdJuMueKdUi2sA2Qempp', priceNormal: 'price_1TuYTtJuMueKdUi2UIo4ZK6K' },
    STPB: { product: 'prod_UttVcmiH3w72RG', priceSale: 'price_1TuDEdJuMueKdUi2WPTaxf6J', priceNormal: 'price_1TuYTaJuMueKdUi2oot6onzi' },
    SIRB: { product: 'prod_UttZtb89Zxokpu', priceSale: 'price_1TuDEdJuMueKdUi23rtgbwUb', priceNormal: 'price_1TuYTHJuMueKdUi2r8xl3epL' },
    SIPB: { product: 'prod_UttXXqkMMllcK4', priceSale: 'price_1TuDEcJuMueKdUi26kPlWCcO', priceNormal: 'price_1TuYSmJuMueKdUi2gKYrtRQ5' },
    SIRL: { product: 'prod_UttW9sZZ8LDGE3', priceSale: 'price_1TuDEaJuMueKdUi2dQvjCURS', priceNormal: 'price_1TuYSUJuMueKdUi2AVhCRQwv' },
    STRL: { product: 'prod_UttTuaGO5FzjwJ', priceSale: 'price_1TuDEbJuMueKdUi2U5DLJEDX', priceNormal: 'price_1TuYSBJuMueKdUi2GCfdvsLM' },
    STRB: { product: 'prod_UttV9PHdpP1YpT', priceSale: 'price_1TuDEbJuMueKdUi2suEt6dH8', priceNormal: 'price_1TuYRoJuMueKdUi2FsIF1Fy6' },
    ATPB: { product: 'prod_Utsx7hbSApWZoC', priceSale: 'price_1TuDEYJuMueKdUi2X85Oys3K', priceNormal: 'price_1TuYRWJuMueKdUi2DyIPUzXn' },
    STPL: { product: 'prod_UttSZqwZrzoG7p', priceSale: 'price_1TuDEYJuMueKdUi25MWe72aZ', priceNormal: 'price_1TuYQnJuMueKdUi2GijtpAll' },
  };

  // 全部入りバンドル（16タイプ一括・固定価格 / セール対象外）
  var BUNDLE = {
    code: 'ALL16',
    price: 9800,
    product: 'prod_UwVfNya9zr74xR',
    priceId: 'price_1TwceHJuMueKdUi2qZXeiVhS',
    types: ['AIPL','AIPB','AIRL','AIRB','ATPL','ATPB','ATRL','ATRB','SIPL','SIPB','SIRL','SIRB','STPL','STPB','STRL','STRB'],
  };

  /* ---- 共通ロジック(表示とCheckoutが同じ関数を使う=不一致が構造的に不可能) ---- */

  // 'YYYY-MM-DD' → その日の00:00 JST（時刻付き文字列もそのまま解釈）
  function parseJst(s) {
    if (!s) return null;
    var d = /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(s + 'T00:00:00+09:00') : new Date(s);
    return isNaN(d.getTime()) ? null : d;
  }

  // セールが今有効か: saleEnabled かつ saleStart <= now < saleEnd
  function isSaleActive(now) {
    if (!SHOP_CONFIG.saleEnabled) return false;
    now = now || new Date();
    var st = parseJst(SHOP_CONFIG.saleStart);
    var en = parseJst(SHOP_CONFIG.saleEnd);
    if (st && now < st) return false;
    if (en && now >= en) return false;
    return true;
  }

  // 現在の販売価格(円)
  function activePrice(now) {
    return isSaleActive(now) ? SHOP_CONFIG.currentPrice : SHOP_CONFIG.normalPrice;
  }

  // 現在使用する Stripe Price ID
  function priceIdFor(typeCode, now) {
    if (typeCode === BUNDLE.code) return BUNDLE.priceId;
    var e = PRODUCTS[typeCode];
    if (!e) return null;
    return isSaleActive(now) ? e.priceSale : e.priceNormal;
  }

  // 「8月3日まで」表示用（saleEndは排他境界なので前日=最終販売日を表示）
  function saleEndLabel() {
    var en = parseJst(SHOP_CONFIG.saleEnd);
    if (!en) return '';
    var last = new Date(en.getTime() - 1000);
    // JSTでの月日を取得
    var p = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric' }).format(last);
    return p.replace('/', '月') + '日';
  }
  // 「7月20日から」表示用（開始前の告知等に使用可）
  function saleStartLabel() {
    var st = parseJst(SHOP_CONFIG.saleStart);
    if (!st) return '';
    var p = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric' }).format(st);
    return p.replace('/', '月') + '日';
  }

  g.SHOP_CONFIG = SHOP_CONFIG;
  g.SHOP_PRODUCTS = PRODUCTS;
  g.SHOP_BUNDLE = BUNDLE;
  g.SHOP_IS_SALE_ACTIVE = isSaleActive;
  g.SHOP_ACTIVE_PRICE = activePrice;
  g.SHOP_PRICE_ID = priceIdFor;
  g.SHOP_SALE_END_LABEL = saleEndLabel;
  g.SHOP_SALE_START_LABEL = saleStartLabel;
})(typeof globalThis !== 'undefined' ? globalThis : window);
